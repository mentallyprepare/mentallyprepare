# .env.example
PORT=8080
NODE_ENV=production

# --- App Config ---
APP_BASE_URL=https://your-app-url.com
# Set only after confirming this inbox or alias receives mail.
CONTACT_EMAIL=hello@mymentallyprepare.com
DATA_DIR=/data/db

# --- Session Secret (set this permanently in Railway) ---
SESSION_SECRET=your-session-secret

# --- Admin ---
ADMIN_PASSWORD=your-admin-password
# Deprecated grace-period path. Use POST /admin/login against a named admin
# in the admin_users table instead. ADMIN_PASSWORD stays working until every
# operator has migrated, then remove this variable.

# --- First-admin bootstrap (only used on empty admin_users table) ---
# Set these once, deploy, log in as this admin, then remove both variables.
# Password must be at least 12 characters. Any subsequent restart with these
# set is a silent no-op — bootstrap only fires when admin_users is empty.
# ADMIN_BOOTSTRAP_EMAIL=you@yourdomain.com
# ADMIN_BOOTSTRAP_PASSWORD=a-secure-passphrase-12-chars-min

# --- Feature flags (off unless set to exactly "true") ---
# WALL_ENABLED=true   # Anonymous "Me Too" wall
# ROOMS_ENABLED=true  # Anonymous topic rooms (cards, reactions, peer comments)

# --- Email (Resend preferred, or SMTP fallback) ---
RESEND_API_KEY=re_xxxxxxxx
# Use an address at the verified sending domain; confirm the mailbox or reply alias exists.
RESEND_FROM_EMAIL=notifications@mymentallyprepare.com
# SMTP fallback (only if Resend is not set):
# SMTP_HOST=smtp.example.com
# SMTP_USER=user
# SMTP_PASS=pass
# SMTP_FROM_EMAIL=notifications@mymentallyprepare.com

# --- Backups (S3-compatible, e.g. Cloudflare R2) ---
BACKUP_S3_BUCKET=your-bucket-name
BACKUP_S3_ACCESS_KEY=your-access-key
BACKUP_S3_SECRET_KEY=your-secret-key
BACKUP_S3_REGION=auto
# BACKUP_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Firebase Google Auth ---
# Web config values come from Firebase Console > Project settings > Your apps.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# Set to true only after adding your app-domain OAuth redirect URI in Google Cloud:
# https://yourdomain.com/__/auth/handler
FIREBASE_USE_SAME_ORIGIN_AUTH_DOMAIN=false
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend verification uses a Firebase service account.
# Prefer one JSON env var in production, or use the split vars below.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Stripe ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec-your-stripe-webhook-secret

# --- Sentry (crash reporting, stack traces only — no PII, no user content) ---
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/1234567
