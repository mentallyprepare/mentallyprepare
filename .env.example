# .env.example
PORT=8080
NODE_ENV=production

# --- App Config ---
APP_BASE_URL=https://your-app-url.com
CONTACT_EMAIL=your@email.com
DATA_DIR=/data/db

# --- Session Secret (set this permanently in Railway) ---
SESSION_SECRET=your-session-secret

# --- Admin ---
ADMIN_PASSWORD=your-admin-password

# --- SendGrid Email ---
SENDGRID_API_KEY=SG.xxxxxxxx
SENDGRID_FROM=noreply@yourdomain.com

# --- Firebase Google Auth ---
# Web config values come from Firebase Console > Project settings > Your apps.
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend verification uses a Firebase service account.
# Prefer one JSON env var in production, or use the split vars below.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Stripe ---
STRIPE_SECRET_KEY=your-stripe-secret-key
